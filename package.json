{
  "name": "filename-collision-key",
  "version": "0.1.0",
  "description": "Compute a target-filesystem collision key for a proposed filename, and refuse names whose identity differs between filesystem profiles.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": { "build": "tsc", "prepack": "npm run build", "test": "vitest run" },
  "keywords": [
    "filename",
    "filesystem",
    "collision",
    "unicode",
    "normalization",
    "ntfs",
    "apfs",
    "case-insensitive",
    "upload"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nradawg/filename-collision-key.git"
  },
  "author": "Nick Raddon",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "devDependencies": { "typescript": "^5.5.0", "vitest": "^2.0.0" }
}
